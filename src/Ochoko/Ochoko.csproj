<Project Sdk="Microsoft.NET.Sdk">
  <!--
    net48 なのは、A.I.VOICE の COM サーバーが .NET Framework のプロセス内コンポーネントで、
    .NET (Core) のプロセスには読み込めないため。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>ochoko</AssemblyName>
    <RootNamespace>Ochoko</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Microsoft.CSharp" />
    <ProjectReference Include="..\Ochoko.Core\Ochoko.Core.csproj" />
  </ItemGroup>
</Project>
